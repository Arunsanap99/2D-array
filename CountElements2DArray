public class CountElements2DArray {

    // Q13: Write a Java program to count positive, negative and zero elements in a 2D array.

    public static void main(String[] args) {

        int matrix[][] = {
                {1, -2, 0},
                {-4, 5, 6},
                {0, -8, 9}
        };

        int positive = 0;
        int negative = 0;
        int zero = 0;

        for (int i = 0; i < matrix.length; i++) {

            for (int j = 0; j < matrix[0].length; j++) {

                if (matrix[i][j] > 0) {
                    positive++;
                }
                else if (matrix[i][j] < 0) {
                    negative++;
                }
                else {
                    zero++;
                }
            }
        }

        System.out.println("Positive = " + positive);
        System.out.println("Negative = " + negative);
        System.out.println("Zero = " + zero);
    }
}
