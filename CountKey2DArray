public class CountKey2DArray {

    // Q18: Write a Java program to count how many times a key occurs in a 2D array.

    public static void main(String[] args) {

        int matrix[][] = {
                {1, 2, 3},
                {2, 5, 2},
                {7, 8, 2}
        };

        int key = 2;
        int count = 0;

        for (int i = 0; i < matrix.length; i++) {

            for (int j = 0; j < matrix[0].length; j++) {

                if (matrix[i][j] == key) {
                    count++;
                }
            }
        }

        System.out.println("Key " + key + " occurs " + count + " times.");
    }
}
